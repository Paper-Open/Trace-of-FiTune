fsd=default,openflags=o_direct,shared=yes
fsd=fsd0,anchor=@DATA@/ai,depth=4,width=6,files=10,size=(53739520,30,107347968,40,214695936,30)

fwd=format,thread=128,xfersize=4m
fwd=default,thread=768
fwd=fwd1,fsd=fsd0,operation=write,xfersize=128k,fileio=sequential,fileselect=sequential,skew=10
fwd=fwd2,fsd=fsd0,operation=write,xfersize=64k,fileio=sequential,fileselect=sequential,skew=10
fwd=fwd3,fsd=fsd0,operation=read,xfersize=128k,fileio=sequential,fileselect=sequential,skew=20
fwd=fwd4,fsd=fsd0,operation=read,xfersize=64k,fileio=sequential,fileselect=sequential,skew=20
fwd=fwd5,fsd=fsd0,operation=read,xfersize=128k,fileio=random,fileselect=random,skew=20
fwd=fwd6,fsd=fsd0,operation=read,xfersize=64k,fileio=random,fileselect=random,skew=20

rd=rd1,fwd=fwd*,fwdrate=max,format=no,elapsed=600,interval=1,warmup=60
