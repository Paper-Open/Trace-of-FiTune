data_errors=1
create_anchors=yes
messagescan=nodisplay

hd=default,vdbench=@VDBENCH@,user=@USER@,shell=ssh
hd=hd1,system=@HOST01@
hd=hd2,system=@HOST02@
hd=hd3,system=@HOST03@
hd=hd4,system=@HOST04@
hd=hd5,system=@HOST05@
hd=hd6,system=@HOST06@
hd=hd7,system=@HOST07@
hd=hd8,system=@HOST08@

fsd=fsd1,anchor=@DATA@/smallfile,depth=1,width=10000,files=1000,sizes=4k,shared=yes,openflags=o_direct

fwd=fwd11,host=hd1,fsd=fsd1,xfersizes=4k,threads=128,operation=write,fileio=random,fileselect=random
fwd=fwd12,host=hd2,fsd=fsd1,xfersizes=4k,threads=128,operation=write,fileio=random,fileselect=random
fwd=fwd13,host=hd3,fsd=fsd1,xfersizes=4k,threads=128,operation=write,fileio=random,fileselect=random
fwd=fwd14,host=hd4,fsd=fsd1,xfersizes=4k,threads=128,operation=write,fileio=random,fileselect=random
fwd=fwd15,host=hd5,fsd=fsd1,xfersizes=4k,threads=128,operation=write,fileio=random,fileselect=random
fwd=fwd16,host=hd6,fsd=fsd1,xfersizes=4k,threads=128,operation=write,fileio=random,fileselect=random
fwd=fwd17,host=hd7,fsd=fsd1,xfersizes=4k,threads=128,operation=write,fileio=random,fileselect=random
fwd=fwd18,host=hd8,fsd=fsd1,xfersizes=4k,threads=128,operation=write,fileio=random,fileselect=random

rd=rd1,fwd=fwd1*,elapsed=600,interval=1,format=no,fwdrate=max
