data_errors=1,create_anchors=yes,messagescan=no
hd=default,shell=ssh,vdbench=@VDBENCH@,user=@USER@
hd=hd1,system=@HOST01@
hd=hd2,system=@HOST02@
hd=hd3,system=@HOST03@
hd=hd4,system=@HOST04@
hd=hd5,system=@HOST05@
hd=hd6,system=@HOST06@
hd=hd7,system=@HOST07@
hd=hd8,system=@HOST08@
hd=hd9,system=@HOST09@
hd=hd10,system=@HOST10@
hd=hd11,system=@HOST11@
hd=hd12,system=@HOST12@
hd=hd13,system=@HOST13@
hd=hd14,system=@HOST14@
hd=hd15,system=@HOST15@
hd=hd16,system=@HOST16@

fsd=default,openflags=o_direct,shared=yes
fsd=fsd0,anchor=@DATA@/mixed-ops/dir0,depth=4,width=5,files=36,size=(64K,67,128K,33)
fsd=fsd1,anchor=@DATA@/mixed-ops/dir1,depth=4,width=5,files=36,size=(64K,67,128K,33)
fsd=fsd2,anchor=@DATA@/mixed-ops/dir2,depth=4,width=5,files=36,size=(64K,67,128K,33)
fsd=fsd3,anchor=@DATA@/mixed-ops/dir3,depth=4,width=5,files=36,size=(64K,67,128K,33)
fsd=fsd4,anchor=@DATA@/mixed-ops/dir4,depth=4,width=5,files=4,size=(1M,50,2M,20,8M,10,128M,10,1G,10)
fsd=fsd5,anchor=@DATA@/mixed-ops/dir5,depth=4,width=5,files=4,size=(1M,50,2M,20,8M,10,128M,10,1G,10)
fsd=fsd6,anchor=@DATA@/mixed-ops/dir6,depth=4,width=5,files=4,size=(1M,50,2M,20,8M,10,128M,10,1G,10)
fsd=fsd7,anchor=@DATA@/mixed-ops/dir7,depth=4,width=5,files=4,size=(1M,50,2M,20,8M,10,128M,10,1G,10)


fwd=default,thread=512
fwd=fwd0,fsd=(fsd0-fsd7),operation=read,xfersize=32k,fileio=sequential,fileselect=sequential,skew=20
fwd=fwd1,fsd=(fsd0-fsd7),operation=getattr,xfersize=32k,fileio=sequential,fileselect=sequential,skew=20
fwd=fwd2,fsd=(fsd0-fsd7),operation=read,xfersize=12k,fileio=sequential,fileselect=sequential,skew=10
fwd=fwd3,fsd=(fsd0-fsd7),operation=write,xfersize=12k,fileio=sequential,fileselect=sequential,skew=10
fwd=fwd4,fsd=(fsd0-fsd7),operation=read,xfersize=64k,fileio=sequential,fileselect=sequential,skew=10
fwd=fwd5,fsd=(fsd0-fsd7),operation=write,xfersize=64k,fileio=sequential,fileselect=sequential,skew=10
fwd=fwd6,fsd=(fsd0-fsd7),operation=read,xfersize=8k,fileio=sequential,fileselect=sequential,skew=10
fwd=fwd7,fsd=(fsd0-fsd7),operation=write,xfersize=8k,fileio=sequential,fileselect=sequential,skew=10

rd=rd1,fwd=(fwd*),fwdrate=max,format=no,elapsed=600,interval=1,warmup=60
